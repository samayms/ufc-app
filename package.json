{
  "name": "ufc-live-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "collector": "node --env-file-if-exists=.env server/collector.ts",
    "replay": "node --env-file-if-exists=.env server/replay.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:collector": "vitest run server",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "sync:upcoming": "node --env-file-if-exists=.env server/syncUpcoming.ts",
    "sync:upcoming:live": "DATA_MODE=live node --env-file-if-exists=.env server/syncUpcoming.ts",
    "sherdog:find": "node --env-file-if-exists=.env scripts/findSherdogLiveBlog.mjs",
    "sherdog:outlook:find": "node --env-file-if-exists=.env scripts/findSherdogOutlook.mjs",
    "sherdog:outlook:import": "node --env-file-if-exists=.env scripts/importFightOutlooks.mjs",
    "sherdog:outlook:watch": "node --env-file-if-exists=.env scripts/watchSherdogOutlook.mjs",
    "collector:live": "DATA_MODE=live node --env-file-if-exists=.env server/collector.ts",
    "dev:live": "DATA_MODE=live node --env-file-if-exists=.env scripts/devLive.mjs",
    "app": "node scripts/weekend.mjs",
    "weekend": "npm run app",
    "lab": "node --env-file-if-exists=.env server/lab/server.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shadcn": "^4.16.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
